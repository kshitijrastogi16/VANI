PROJECT_NAME=VANI
PROJECT_VERSION=3.0.0
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000
AUTO_RELOAD=false

DATABASE_PATH=data/processed/ramayana.db
FTS_TABLE=verses_fts

EMBEDDINGS_DIR=data/processed/embeddings
PRIMARY_EMBEDDING_MODEL=BAAI/bge-m3
FALLBACK_EMBEDDING_MODEL=intfloat/multilingual-e5-large
TERTIARY_EMBEDDING_MODEL=l3cube-pune/indic-sentence-similarity-sbert
EMBEDDING_DIM=1024
BATCH_SIZE=32

BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
HYBRID_TOP_K=10

ENTITY_CONFIDENCE_THRESHOLD=0.7
CHARACTERS_PATH=data/raw/characters.json
LOCATIONS_PATH=data/raw/locations.json

CITATION_CONTEXT_WINDOW=2

GROQ_API_KEY=
GROQ_MODELS=["openai/gpt-oss-120b","qwen/qwen3.8-27b","openai/gpt-oss-20b"]
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

WEB_STATIC_DIR=web/static
WEB_TEMPLATES_DIR=web/templates

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

LOG_LEVEL=INFO
LOG_FILE=logs/vani.log

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

DEV_MODE=false
ENABLE_PROFILING=false
